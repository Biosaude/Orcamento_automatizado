# Valores ilustrativos. Não usar segredos reais neste arquivo.
BIOSAUDE_ENVIRONMENT=development
# Habilitar cadastros somente após auditar grants/RLS de todos os acessos ao banco.
BIOSAUDE_CATALOG_ENABLED=false

# PostgreSQL opcional. Vazio mantém o banco desabilitado. Ver docs/database.md.
# Exemplo fictício: postgresql+psycopg://example_user:example_password@db.example.invalid:5432/example_db
BIOSAUDE_DATABASE_URL=
# Diagnóstico restrito. Vazio nega acesso; injetar token seguro fora do exemplo.
BIOSAUDE_DATABASE_HEALTH_TOKEN=
BIOSAUDE_DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
BIOSAUDE_DATABASE_CONNECT_TIMEOUT=5
BIOSAUDE_DATABASE_STATEMENT_TIMEOUT_MS=5000
BIOSAUDE_DATABASE_POOL_SIZE=5
BIOSAUDE_DATABASE_MAX_OVERFLOW=0
BIOSAUDE_DATABASE_POOL_TIMEOUT=5

# Supabase Auth: origem HTTPS confiável do projeto. Vazio nega acesso operacional.
# Não requer service_role nem segredo JWT. Ver docs/auth-catalog.md.
BIOSAUDE_SUPABASE_URL=

# Integrações HTTP futuras; não usadas pela conexão PostgreSQL.
BIOSAUDE_LOCAWEB_SMTP_HOST=smtp.example.invalid
BIOSAUDE_LOCAWEB_SMTP_PORT=587
BIOSAUDE_LOCAWEB_SMTP_USERNAME=example@example.invalid
BIOSAUDE_LOCAWEB_SMTP_PASSWORD=replace_with_local_secret
BIOSAUDE_OPENAI_API_KEY=replace_with_local_secret
BIOSAUDE_TWILIO_ACCOUNT_SID=replace_with_local_secret
BIOSAUDE_TWILIO_AUTH_TOKEN=replace_with_local_secret
BIOSAUDE_TWILIO_FROM_NUMBER=replace_with_local_sender

# Identificador futuro da tabela oficial validada. Vazio = exceção não configurada.
BIOSAUDE_SAO_CAMILO_TABLE_ID=
