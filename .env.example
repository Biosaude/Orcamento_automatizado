# Valores ilustrativos. Não usar segredos reais neste arquivo.
BIOSAUDE_ENVIRONMENT=development

# Configuração futura; nenhum cliente ou conexão externa está implementado.
BIOSAUDE_DATABASE_URL=postgresql://example_user:example_password@localhost:5432/example_db
BIOSAUDE_SUPABASE_URL=https://example-project.supabase.co
BIOSAUDE_SUPABASE_SERVICE_ROLE_KEY=replace_with_local_secret
BIOSAUDE_LOCAWEB_SMTP_HOST=smtp.example.invalid
BIOSAUDE_LOCAWEB_SMTP_PORT=587
BIOSAUDE_LOCAWEB_SMTP_USERNAME=example@example.invalid
BIOSAUDE_LOCAWEB_SMTP_PASSWORD=replace_with_local_secret
BIOSAUDE_OPENAI_API_KEY=replace_with_local_secret
BIOSAUDE_TWILIO_ACCOUNT_SID=replace_with_local_secret
BIOSAUDE_TWILIO_AUTH_TOKEN=replace_with_local_secret
BIOSAUDE_TWILIO_FROM_NUMBER=replace_with_local_sender

# Identificador futuro da tabela oficial validada. Vazio = exceção não configurada.
BIOSAUDE_SAO_CAMILO_TABLE_ID=
